# Frontend (Cloudflare Pages → Variables de entorno)
VITE_PUSH_API_URL=https://checklist-reminders.<tu-subdominio>.workers.dev
# Opcional si no quieres depender de GET /vapid-public-key
# VITE_VAPID_PUBLIC_KEY=

# Worker (no subir secretos al repo). Crear con:
#   cd worker && node scripts/generate-vapid.mjs
# Luego:
#   npx wrangler secret put VAPID_PUBLIC_KEY
#   npx wrangler secret put VAPID_PRIVATE_KEY
