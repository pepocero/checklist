{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "checklist-reminders",
	"main": "src/index.ts",
	"compatibility_date": "2026-03-01",
	"workers_dev": true,
	"vars": {
		"VAPID_SUBJECT": "mailto:contacto@carlinitools.com"
	},
	"kv_namespaces": [
		{
			"binding": "REMINDERS",
			"id": "d990c1e8276a48888ab4ad77fc5925b1",
			"preview_id": "d990c1e8276a48888ab4ad77fc5925b1",
			"remote": true
		}
	],
	"triggers": {
		"crons": [
			"* * * * *"
		]
	}
}